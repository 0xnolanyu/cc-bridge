    "type": "git",
    "url": "git+https://github.com/0xnolanyu/cc-bridge.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/0xnolanyu/cc-bridge#readme",
  "bugs": {
    "url": "https://github.com/0xnolanyu/cc-bridge/issues"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "messaging",
    "bridge"
  ],
  "author": "0xnolanyu"
}
